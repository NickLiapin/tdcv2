# The Gradle wrapper jar is the one jar that belongs in the repository: without it
# `./gradlew` cannot bootstrap, and a fresh clone would need Gradle installed globally.
!java/gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
.gradle/
gradle-app.setting

# ─── ANTLR (generated parsers, check in per-language) ────────
# Note: generated parsers may live under packages/*/src/generated/
# Each language decides whether to commit generated code or regenerate.
# Common default: regenerate via build, don't commit.
**/generated/
!grammar/**

# Local tooling cache
.cache/

# Temporary copy of the shared data packs, created by npm prepack.
typescript/data/
typescript/.packs-staging/
typescript/.packs-removing/

