<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The generated parser is ANTLR's, not ours: it does not carry the CLS attributes the
         compiler would like, and there is nothing to fix in a file we do not write. -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>

  <!-- What NuGet shows and what it installs. Equal version numbers across the five
       implementations mean the same engine: they are held to one contract by
       fixtures/cross-language/, so the same version number from NuGet and from npm
       produces the same bytes for the same config and seed. -->
  <PropertyGroup>
    <PackageId>Tdcv2</PackageId>
    <Version>0.2.0</Version>
    <Authors>Nikolai Liapin</Authors>
    <Description>Deterministic test-data generator: coherent records, exact proportions, and any text format you describe. Same seed, same bytes — in C#, TypeScript, Python, Java and Rust alike.</Description>
    <PackageTags>test-data;mock-data;fake-data;synthetic-data;data-generator;deterministic;fixtures;testing;csv;json;parquet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nickliapin.github.io/tdcv2/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/NickLiapin/tdcv2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    The starter data packs, embedded INTO the assembly rather than shipped beside it.

    `scripts/bundle-packs.mjs add` stages them here before `dotnet pack`; the folder is
    gitignored, because the packs live once at the repository root and a second committed copy
    would shadow the real one and go quietly out of date. A checkout matches nothing here and
    falls back to reading data/packs from disk, which is what keeps this implementation and the
    other four looking at the same bytes.

    `LogicalName` gives every file the same `tdc/packs/…` prefix the jar uses, so the two ports
    name their resources identically.

    Everything staged is embedded, not just `*.txt`: a pack's extension carries no meaning — a
    `.txt` is a list of values and a `.tdc` is a body that builds one, and both are addressed by
    path alone. The staging script drops the manifests and READMEs, so this glob has nothing to
    filter; embedding by extension is what left every composed pack out of the assembly.
  -->
  <ItemGroup>
    <EmbeddedResource Include="PacksData/**/*">
      <LogicalName>tdc/packs/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

</Project>
