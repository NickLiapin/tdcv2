{
  "name": "tdcv2",
  "version": "0.3.0",
  "description": "Deterministic test-data generator: coherent records, exact proportions, and any text format you describe. Same seed, same bytes. Also usable as a faker — one call, one value — from the same data packs.",
  "keywords": [
    "test-data",
    "test-data-generator",
    "mock-data",
    "fake-data",
    "fake-data-generator",
    "synthetic-data",
    "synthetic-data-generator",
    "dummy-data",
    "sample-data",
    "data-generator",
    "data-generation",
    "deterministic",
    "seeded",
    "reproducible",
    "coherent-data",
    "fixtures",
    "testing",
    "faker",
    "faker-alternative",
    "csv",
    "json",
    "sql",
    "parquet",
    "cli",
    "dsl",
    "locale",
    "i18n"
  ],
  "license": "MIT",
  "author": "Nikolai Liapin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickLiapin/tdcv2.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/NickLiapin/tdcv2/issues"
  },
  "homepage": "https://nickliapin.github.io/tdcv2/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./esm-only.d.cts",
        "default": "./esm-only.cjs"
      }
    }
  },
  "bin": {
    "tdcv2": "dist/cli/main.js",
    "tdcv2-lsp": "dist/lsp/server.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "data",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "esm-only.d.cts",
    "esm-only.cjs"
  ],
  "scripts": {
    "generate": "node scripts/generate-parser.mjs",
    "generate:force": "node scripts/generate-parser.mjs --force",
    "generate:clean": "rm -rf src/generated && npm run generate",
    "prebuild": "npm run generate",
    "build": "tsc -p tsconfig.build.json",
    "build:data-packs": "node scripts/build-data-packs.mjs",
    "prepack": "node scripts/bundle-packs.mjs add",
    "clean": "rm -rf dist coverage .tsbuildinfo src/generated",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:pack": "vitest run --config vitest.pack.config.ts",
    "test:heavy": "vitest run --config vitest.heavy.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "types:pack": "npx --yes @arethetypeswrong/cli --pack .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run cases && npm run fixtures && npm run diagnostics && npm run engines && npm run parquet && npm run test:pack && npm run packs:ranges && npm run examples:check && npm run docs:examples && npm run docs:diagnostics && npm run quick:check && npm run quick:vectors",
    "postpack": "node scripts/bundle-packs.mjs remove",
    "cases": "npx tsx scripts/cross-language-cases.mjs",
    "cases:update": "npx tsx scripts/cross-language-cases.mjs --update",
    "fixtures": "npx tsx scripts/runtime-fixtures.mjs",
    "fixtures:update": "npx tsx scripts/runtime-fixtures.mjs --update",
    "fixtures:quick": "npm run build && node scripts/quick-vectors.mjs",
    "quick:vectors": "node scripts/quick-vectors.mjs --check",
    "diagnostics": "npx tsx scripts/cross-language-diagnostics.mjs",
    "diagnostics:update": "npx tsx scripts/cross-language-diagnostics.mjs --update",
    "engines": "npx tsx scripts/cross-language-engines.mjs",
    "engines:update": "npx tsx scripts/cross-language-engines.mjs --update",
    "signature": "node scripts/signature/quantile-signature.cjs dist/cli/main.js",
    "parquet": "npx tsx scripts/cross-language-parquet.mjs",
    "parquet:update": "npx tsx scripts/cross-language-parquet.mjs --update",
    "docs:examples": "npx tsx scripts/check-doc-examples.mjs --quiet",
    "docs:diagnostics": "node scripts/check-doc-diagnostics.mjs --quiet",
    "packs:ranges": "node scripts/check-pack-ranges.mjs",
    "quick:types": "npm run build && node scripts/generate-quick-types.mjs",
    "quick:check": "node scripts/generate-quick-types.mjs --check",
    "examples:check": "node ../scripts/generate-examples.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@vitest/coverage-v8": "^4.1.10",
    "antlr-ng": "^1.0.10",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "hyparquet": "^1.26.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.6.0",
    "vitest": "^4.1.10",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "antlr4ng": "^3.0.16",
    "fflate": "^0.8.3",
    "jsep": "^1.4.0"
  },
  "peerDependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "peerDependenciesMeta": {
    "vscode-languageserver": {
      "optional": true
    },
    "vscode-languageserver-textdocument": {
      "optional": true
    }
  }
}
