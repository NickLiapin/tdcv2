{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "distribution-normal",
      "description": "normal spends two draws a row, by Box-Muller",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"normal\" mean=\"170\" sd=\"10\" decimals=\"2\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["179.38", "152.83", "170.71", "153.99", "165.24", "174.37"]
    },
    {
      "name": "distribution-lognormal",
      "description": "lognormal, two draws",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"lognormal\" meanlog=\"10\" sdlog=\"1\" decimals=\"0\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["56256", "3956", "23638", "4443", "13689", "34108"]
    },
    {
      "name": "distribution-exponential",
      "description": "exponential, one draw by inverse CDF",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"exponential\" rate=\"0.5\" decimals=\"3\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["1.011", "3.011", "0.033", "3.016", "0.336", "0.543"]
    },
    {
      "name": "distribution-pareto",
      "description": "pareto, one draw",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"pareto\" alpha=\"1.5\" xmin=\"100\" decimals=\"1\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["185.2", "118.2", "1554.1", "118.2", "346.9", "260.4"]
    },
    {
      "name": "distribution-weibull",
      "description": "weibull, one draw",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"weibull\" shape=\"2\" scale=\"5\" decimals=\"3\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["3.555", "6.135", "0.641", "6.140", "2.050", "2.606"]
    },
    {
      "name": "distribution-poisson",
      "description": "poisson samples a cumulative table by binary search",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"poisson\" lambda=\"4\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["4", "2", "9", "2", "6", "5"]
    },
    {
      "name": "distribution-zipf",
      "description": "zipf returns a 1-based rank",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"zipf\" n=\"20\" s=\"1.2\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["4", "1", "19", "1", "10", "7"]
    },
    {
      "name": "distribution-gamma",
      "description": "gamma has no closed-form inverse and is inverted numerically",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"gamma\" shape=\"2\" scale=\"3\" decimals=\"4\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["6.1027", "2.6540", "18.2137", "2.6497", "9.9951", "8.2805"]
    },
    {
      "name": "distribution-beta",
      "description": "beta, likewise inverted numerically",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"beta\" alpha=\"2\" beta=\"5\" decimals=\"5\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": [
        "0.31095",
        "0.14932",
        "0.67299",
        "0.14909",
        "0.45724",
        "0.39702"
      ]
    },
    {
      "name": "distribution-clipped",
      "description": "min and max clip the sample rather than redrawing it",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" distribution=\"normal\" mean=\"0\" sd=\"1\" decimals=\"1\" min=\"-1\" max=\"1\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["0.9", "-1.0", "0.1", "-1.0", "-0.5", "0.4"]
    },
    {
      "name": "timeseries-trend",
      "description": "A trend-only series takes no draws at all",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"timeseries\" base=\"100\" trend=\"2\" decimals=\"0\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["100", "102", "104", "106", "108", "110"]
    },
    {
      "name": "timeseries-seasonal",
      "description": "A seasonal wave repeats on its period",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"timeseries\" base=\"100\" trend=\"0.5\" period=\"4\" amplitude=\"10\" decimals=\"2\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["100.00", "110.50", "101.00", "91.50", "102.00", "112.50"]
    },
    {
      "name": "timeseries-noise",
      "description": "Noise costs two draws a row",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"timeseries\" base=\"50\" noise=\"3\" decimals=\"3\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["47.025", "51.433", "52.662", "50.269", "45.629", "50.088"]
    },
    {
      "name": "missing-token",
      "description": "missing blanks a row with the token it was given",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"text\" value=\"a,b,c,d,e,f\" percent=\"100,,,,,\" missing=\"0.4\" missing_as=\"NULL\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["a", "NULL", "a", "a", "a", "a"]
    },
    {
      "name": "anomaly-spike",
      "description": "anomaly multiplies the values it selects",
      "config": "<tdc><env count=\"6\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"number\" value=\"1..9\" anomaly=\"0.3\" anomaly_factor=\"10\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": ["60", "2", "90", "2", "8", "7"]
    },
    {
      "name": "timeseries-peak-at-moves-the-peak",
      "description": "peak_at=6 puts the highest row on 6, where the default puts it on 3",
      "config": "<tdc><env count=\"12\" seed=\"unit-test\" local=\"en\" mode=\"memory\"><sequence name=\"V\"><gen type=\"timeseries\" base=\"15\" amplitude=\"10\" period=\"12\" decimals=\"1\" peak_at=\"6\"/></sequence></env><block><line><data>${{V}}</data></line></block></tdc>",
      "expected": [
        "5.0",
        "6.3",
