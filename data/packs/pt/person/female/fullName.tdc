---
description: Portuguese full female name — two given names + maternal and paternal surname (Maria Beatriz Rodrigues Silva).
generator: tdc
locale: pt
---
<sequence name="p">
  <distinct>
    <gen name="f1" type="template" value="pt.person.female.firstName"/>
    <gen name="f2" type="template" value="pt.person.female.firstName"/>
  </distinct>
  <distinct>
    <gen name="l1" type="template" value="pt.person.lastName"/>
    <gen name="l2" type="template" value="pt.person.lastName"/>
  </distinct>
</sequence>
<data>${{p.f1}} ${{p.f2}} ${{p.l1}} ${{p.l2}}</data>
