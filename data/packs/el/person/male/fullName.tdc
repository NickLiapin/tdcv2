---
description: Greek full male name — a single given name and a single surname (Γιώργος Παπαδόπουλος). Greek names carry one surname, unlike the two-surname Spanish form.
generator: tdc
locale: el
---
<sequence name="p">
  <gen name="f" type="template" value="el.person.male.firstName"/>
  <gen name="l" type="template" value="el.person.lastName"/>
</sequence>
<data>${{p.f}} ${{p.l}}</data>
