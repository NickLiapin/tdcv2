---
description: Norwegian full female name — one given name and one surname (Ingrid Haugen). The surname is drawn from the same list as the male one, because Norwegian surnames do not inflect for gender.
generator: tdc
locale: nb
---
<sequence name="p">
  <gen name="f" type="template" value="nb.person.female.firstName"/>
  <gen name="l" type="template" value="nb.person.lastName"/>
</sequence>
<data>${{p.f}} ${{p.l}}</data>
